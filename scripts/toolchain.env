# The single toolchain pin (plan §5.3), sourced by scripts/* after they set $root
# (the repo root). The repo pins the image by registry digest + image ID; the image
# itself is a cache: podman's store, or the saved archive in build/toolchain/.
QMK_IMAGE=localhost/qmk-toolchain:1.2.0-b7d7fa8f
QMK_IMAGE_ID=sha256:4f4c32f9c637dde3ab59c9f9068a1b3b2b098067e7677f8e7cab98d34cdde60b
QMK_IMAGE_SOURCE=ghcr.io/qmk/qmk_cli@sha256:b7d7fa8fb4432b569931de5ad59098cb788f440ed61a62c5126746b71aee0f4a
QMK_IMAGE_ARCHIVE="$root/build/toolchain/qmk-toolchain-1.2.0-b7d7fa8f.oci.tar"   # + .sha256 next to it
